---
import Button from '../brand/Button.astro';
import { COPY } from '../../content/copy';
import { SITE } from '../../config/site';
---

<!-- Self-contained: src/scripts/copy-email.ts wires each [data-copy-email-root] on its own. -->
<div class="copy-email" data-copy-email-root>
  <Button variant="ghost" data-copy-email={SITE.email}>{COPY.buttons.copyEmail}</Button>
  <span class="copy-email-text" data-email-text>{SITE.email}</span>
  <span
    class="copy-email-status"
    role="status"
    aria-live="polite"
    data-copied-text={COPY.buttons.copied}
    data-fallback-mac={COPY.buttons.copyFallbackMac}
    data-fallback-other={COPY.buttons.copyFallbackOther}></span>
</div>

<script>
  import '../../scripts/copy-email';
</script>

<style>
  .copy-email {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .copy-email-text {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  /* Sits just below the row instead of in it, so the empty status never pushes the
     button off the shared centre line with "Email me". It stays in the accessibility
     tree (no display:none) so screen readers still hear "Copied". */
  .copy-email-status {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }
</style>
