---
import { COPY } from '../../content/copy';

const { question, options, fix } = COPY.incident;
const { title, fixTitle, feedback } = COPY.incidentUi;
---

<div class="incident" data-incident>
  <h4 class="incident-title">{title}</h4>

  <fieldset class="incident-options">
    <legend>{question}</legend>
    {
      options.map((option) => (
        <label class="incident-option">
          <input type="radio" name="incident-answer" value={option.id} data-correct={String(option.correct)} />
          <span>{option.label}</span>
        </label>
      ))
    }
  </fieldset>

  <p
    class="incident-feedback"
    aria-live="polite"
    data-incident-feedback
    data-feedback-correct={feedback.correct}
    data-feedback-wrong={feedback.wrong}
  >
  </p>

  <!-- Open by default so the fix is readable without JavaScript; the script hides it until an answer is picked. -->
  <details class="incident-details" open data-incident-details>
    <summary>{fixTitle}</summary>
    <p data-incident-fix>{fix}</p>
  </details>
</div>

<style>
  .incident {
    display: grid;
    gap: var(--space-4);
    padding: clamp(20px, 3vw, 36px);
    border-radius: var(--radius-md);
    background: var(--color-navy);
    color: var(--color-paper);
  }
  .incident-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lime);
  }
  .incident-options {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--space-2);
  }
  .incident-options legend {
    margin-bottom: var(--space-4);
    padding: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 0.6vw + 1rem, 1.4rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .incident-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-4);
    border: 2px solid var(--color-paper);
    border-radius: var(--radius-pill);
    font-weight: 600;
    cursor: pointer;
  }
  .incident-option:hover {
    background: var(--color-navy-soft);
  }
  .incident-option:has(input:checked) {
    background: var(--color-lime);
    border-color: var(--color-lime);
    color: var(--color-navy);
  }
  .incident-option:has(input:focus-visible) {
    outline: 3px solid var(--color-lime);
    outline-offset: 3px;
  }
  .incident-option input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--color-navy);
  }
  .incident-feedback {
    margin: 0;
    font-weight: 700;
    color: var(--color-lime);
  }
  /* Never display:none, even when empty: the live region must stay in the accessibility tree
     so a later announcement is reliable. */
  .incident-feedback:empty {
    min-height: 0;
  }
  .incident-details {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-navy);
  }
  .incident-details summary {
    font-family: var(--font-display);
    font-weight: 800;
    cursor: pointer;
  }
  .incident-details p {
    margin: var(--space-2) 0 0;
  }
</style>
