---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import portrait from '../../assets/photo/ayomikun.jpg';
import Bubble from '../brand/Bubble.astro';
import Button from '../brand/Button.astro';
import Stroke from '../brand/Stroke.astro';
import { COPY } from '../../content/copy';
import { SITE } from '../../config/site';
import { buildMailtoUrl } from '../../lib/mailto';
import CopyEmailButton from '../contact/CopyEmailButton.astro';

const cvFileName = SITE.cvPath.slice(1);
const mailtoHref = buildMailtoUrl(SITE.email, SITE.mailSubject);
const linkOrder = ['github', 'linkedin', 'upwork', 'medium'] as const;
const PHOTO_SIZE_PX = 200;
---

<Section id="contact">
  <div class="contact">
    <div class="contact-portrait">
      <Bubble text={COPY.mascot.contact} />
      <Image
        class="contact-photo-image"
        src={portrait}
        alt={COPY.contact.photoAlt}
        width={PHOTO_SIZE_PX}
        height={PHOTO_SIZE_PX}
        densities={[1, 2]}
      />
    </div>
    <div class="contact-body">
      <div class="contact-arrow"><Stroke kind="arrow" /></div>
      <div class="contact-actions">
        <Button href={mailtoHref} variant="primary">{COPY.buttons.email}</Button>
        <Button href={SITE.cvPath} download={cvFileName} variant="secondary">
          <span aria-hidden="true">↓ </span>{COPY.buttons.downloadCv}
        </Button>
        <CopyEmailButton />
      </div>
      <h3 class="contact-links-heading">{COPY.contact.linksHeading}</h3>
      <ul class="contact-links">
        {
          linkOrder.map((key) => (
            <li>
              <a href={SITE.links[key]} rel="noopener">
                {COPY.contact.links[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .contact-portrait {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  /* The contact section closes on the real person, so the recruiter knows who they're emailing. */
  .contact-photo-image {
    width: clamp(160px, 50vw, 200px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--color-white);
    box-shadow: 0 0 0 3px var(--color-navy), var(--shadow-sticker);
    transform: rotate(3deg);
  }
  .contact-body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .contact-arrow {
    width: 120px;
  }
  .contact-links-heading {
    font-size: 1rem;
    font-weight: 800;
  }
  .contact-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .contact-links a {
    display: inline-block;
    padding: 8px 18px;
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
  }
  .contact-links a:hover {
    background: var(--color-navy);
    color: var(--color-paper);
  }
</style>
