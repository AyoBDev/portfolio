---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { COPY } from '../../content/copy';
import { ROLES, EDUCATION } from '../../content/experience';
import { formatMonthRange } from '../../lib/dates';
---

<Section id="experience">
  <div class="experience-layout">
  <ol class="timeline">
    {
      ROLES.map((role) => (
        <li class="card timeline-item">
          <p class="timeline-dates">
            {formatMonthRange(role.start, role.end, COPY.experience.present)}
          </p>
          <h3>{role.title}</h3>
          <p class="timeline-org">
            {role.org}
            {role.label && <span class="timeline-label">{role.label}</span>}
          </p>
          {role.points.length > 0 && (
            <ul class="chips">
              {role.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
          {role.photo && (
            <figure class="timeline-photo">
              <Image src={role.photo.src} alt={role.photo.alt} widths={[370, 740]} sizes="(min-width: 1024px) 480px, 100vw" loading="lazy" />
              <figcaption>{role.photo.caption}</figcaption>
            </figure>
          )}
        </li>
      ))
    }
  </ol>

  <div class="education">
    <h3>{COPY.experience.educationHeading}</h3>
    <div class="card education-card">
      <p class="education-school">{EDUCATION.school}</p>
      <p>{EDUCATION.degree}</p>
      <p class="education-years">{EDUCATION.startYear} – {EDUCATION.endYear}</p>
      <p class="education-grade">{EDUCATION.grade}</p>
      <h4 class="education-activities-heading">{COPY.experience.activitiesHeading}</h4>
      <ul class="education-activities">
        {
          EDUCATION.activities.map((activity) => (
            <li>
              <p class="education-activity-role">
                {activity.role}, <span>{activity.group}</span>
              </p>
              <p>{activity.result}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  </div>
</Section>

<style>
  /* Stacked on small screens; on desktop education sits beside the timeline so the
     section fills the same width as the others instead of leaving the right side empty. */
  .experience-layout {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
  }
  @media (min-width: 1024px) {
    .experience-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-6);
    border-left: 4px solid var(--color-navy);
    display: grid;
    gap: var(--space-6);
  }
  .timeline-item {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }
  /* The dot sits on the timeline rail. */
  .timeline-item::before {
    content: '';
    position: absolute;
    /* Centres the 16px dot on the 4px rail. */
    left: calc(var(--space-6) * -1 - 10px);
    top: 28px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-navy);
    border: 3px solid var(--color-lime);
  }
  .timeline-item p {
    margin: 0;
  }
  .timeline-item h3 {
    font-size: clamp(20px, 1rem + 0.8vw, 28px);
  }
  .timeline-photo {
    margin: var(--space-2) 0 0;
    max-width: 480px;
  }
  .timeline-photo img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-md);
  }
  .timeline-photo figcaption {
    margin-top: var(--space-2);
    font-size: 0.9rem;
    color: var(--color-slate);
  }
  .timeline-dates,
  .education-years {
    color: var(--color-slate);
    font-weight: 600;
  }
  .timeline-org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  .timeline-label {
    padding: 2px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-lime);
    color: var(--color-navy);
    font-size: 0.85rem;
  }
  .education {
    display: grid;
    gap: var(--space-4);
  }
  .education-card p {
    margin: 0;
  }
  .education-school {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .education-activities-heading {
    margin: var(--space-6) 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
  }
  .education-activities {
    margin: 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  .education-activity-role {
    font-weight: 700;
  }
  .education-activity-role span {
    font-weight: 600;
    color: var(--color-slate);
  }
  .education-grade {
    display: inline-block;
    margin-top: var(--space-2) !important;
    padding: 2px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-lime);
    font-weight: 600;
  }
</style>
