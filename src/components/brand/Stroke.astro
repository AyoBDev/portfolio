---
interface Props {
  kind: 'arrow' | 'underline' | 'burst';
}

const { kind } = Astro.props;

// Hand-drawn paths: an arrow with a loop, a double underline (second line
// shorter and inset), and a three-line burst.
const STROKES = {
  arrow: {
    viewBox: '0 0 160 90',
    width: 6,
    paths: [
      'M6 70C30 74 52 58 58 40C62 26 46 22 42 34C38 48 62 56 90 42C112 31 128 26 150 24',
      'M132 8L152 24L134 42',
    ],
  },
  underline: {
    viewBox: '0 0 200 36',
    width: 8,
    paths: ['M4 12C50 6 120 16 196 8', 'M30 28C80 24 130 30 170 26'],
  },
  burst: {
    viewBox: '0 0 80 80',
    width: 6,
    paths: ['M40 6L40 28', 'M8 24L26 38', 'M72 24L54 38'],
  },
} as const;

const stroke = STROKES[kind];
---

<svg
  class="stroke"
  viewBox={stroke.viewBox}
  fill="none"
  stroke="var(--color-navy)"
  stroke-width={stroke.width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {stroke.paths.map((d) => <path d={d} />)}
</svg>

<style>
  .stroke {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
