---
interface Props {
  href?: string;
  variant: 'primary' | 'secondary' | 'ghost';
  type?: 'button';
  /** For links: the file name the browser saves the target as. */
  download?: string;
  [attribute: `data-${string}`]: string | undefined;
}

const { href, variant, type = 'button', download, ...extraAttributes } = Astro.props;
const Element = href ? 'a' : 'button';
const elementProps = href ? { href, download } : { type };
---

<Element class={`button button--${variant}`} {...elementProps} {...extraAttributes}>
  <slot />
</Element>

<style>
  .button {
    display: inline-block;
    padding: var(--space-4) var(--space-6);
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
  }
  .button--primary {
    background: var(--color-navy);
    color: var(--color-paper);
  }
  /* Between the two: a filled white pill, for the second most important action (the CV). */
  .button--secondary {
    background: var(--color-white);
    color: var(--color-navy);
  }
  .button--ghost {
    background: transparent;
    color: var(--color-navy);
  }
</style>
